# ==========================================
# domainyourlink Environment Configuration
# ==========================================

# 1. Database Connection URL (Neon / PostgreSQL / Supabase)
# Example Neon Connection String:
# DATABASE_URL="postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/domainyourlink"

# 2. CEO Portal Master Password
# The master password you type when logging into https://domainyourlink.vercel.app/ceo
CEO_PASSWORD="your_master_ceo_password_here"

# 3. Security Secret Key (optional - defaults to secure random key if left empty)
JWT_SECRET="your_random_secret_string_minimum_32_characters_long"

# 4. Email Sending for 6-Digit Codes & Team Invites (Gmail App Password)
# Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER="yourcompany@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
