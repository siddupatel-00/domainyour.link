# Database connection URL (PostgreSQL / Neon / Vercel Postgres)
# Example Neon / Vercel Postgres URL:
# DATABASE_URL="postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/permanentlink"

# Admin dashboard password (fallback)
ADMIN_PASSWORD="admin"

# Secret key for signing admin session tokens (min 32 chars)
ADMIN_JWT_SECRET="your_random_secret_string_minimum_32_characters_long"

# Gmail SMTP for sending 6-digit verification codes (Google App Password)
# 1. Go to your Google Account -> Security -> 2-Step Verification -> App passwords
# 2. Create an App password for "Mail" (16 characters)
GMAIL_USER="yourname@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Public URL of your deployed app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
