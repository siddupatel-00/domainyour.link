# ==========================================
# PermanentLink Environment Configuration
# ==========================================

# 1. PostgreSQL Database URL (Neon / Supabase / Vercel Postgres / Railway)
# Example: postgresql://username:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/permanentlink"

# 2. Authentication Secrets
# Secret key for cryptographically signing session JWTs (minimum 32 random characters)
JWT_SECRET="your_random_secret_string_minimum_32_characters_long"

# Default password for creator admin login
ADMIN_PASSWORD="admin"

# Master password for CEO Executive Command Portal (/ceo)
CEO_PASSWORD="ceo_master_password_here"

# 3. Email Delivery for Verification Codes & Employee Invitations (Gmail SMTP / Google App Password)
# To create an app password:
# Google Account -> Security -> 2-Step Verification -> App passwords -> Name it "PermanentLink" (16 characters)
GMAIL_USER="yourcompany@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# 4. Public URL of your deployed application
# When deploying to Vercel/Custom Domain, set this to your live domain (e.g. https://permanentlink.com or https://yourapp.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
